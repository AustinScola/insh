#!/usr/bin/env bash

# Serve the docs and rebuild them whenever they change.

set -euo pipefail

REPO_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

source "${REPO_ROOT}/scripts/lib/bootstrap.sh"
source "${REPO_ROOT}/scripts/lib/ensure-mdbook-installed.sh"

BOOTSTRAP="$(bootstrap)"
if [[ "${BOOTSTRAP}" == "yes" ]]; then
    ensure_mdbook_installed
fi

mdbook serve --open "${REPO_ROOT}/docs"
